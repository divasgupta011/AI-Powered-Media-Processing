{
  "name": "camarin-media-pipeline",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm -w @camarin/api run dev",
    "dev:worker": "npm -w @camarin/worker run dev",
    "dev:web": "npm -w @camarin/web run dev",
    "db:generate": "npm -w @camarin/db run generate",
    "db:migrate": "npm -w @camarin/db run migrate",
    "infra:up": "docker compose up -d db redis minio minio-setup",
    "infra:down": "docker compose down",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
