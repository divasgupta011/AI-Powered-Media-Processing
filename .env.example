# copy to .env. defaults below match docker-compose.

NODE_ENV=development

API_PORT=4000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

DATABASE_URL=postgresql://camarin:camarin@localhost:5432/camarin?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

MAX_FILE_SIZE_MB=5

# AI_MOCK=true runs the pipeline without hitting the real apis (no keys needed)
AI_MOCK=true

# https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
HF_CAPTION_MODEL=Salesforce/blip-image-captioning-base

# service account json with the Vision API enabled
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-vision.json
