# copy to .env. defaults below match docker-compose.

NODE_ENV=development

API_PORT=4000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

DATABASE_URL=postgresql://camarin:camarin@localhost:5432/camarin?schema=public
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=media-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

MAX_FILE_SIZE_MB=5

# AI_MOCK=true runs the pipeline without hitting the real apis (no keys needed)
AI_MOCK=true

# read token from https://huggingface.co/settings/tokens - needed to download the
# caption model from the hub (HF dropped anonymous downloads). captioning runs
# locally via transformers.js; blip's hosted endpoint was retired so we use an
# onnx caption model instead (model choice is open per the spec).
HUGGINGFACE_API_TOKEN=
HF_CAPTION_MODEL=Xenova/vit-gpt2-image-captioning

# caption backend: "local" (in-process, no provider needed) or "vlm" (hosted vision
# LLM via HF inference providers - needs a provider enabled at
# https://huggingface.co/settings/inference-providers and spends your HF credit)
CAPTION_PROVIDER=local
HF_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

# Google Vision (labels + safety). Empty = mock, no key needed.
# To use real Vision: enable the Cloud Vision API on a GCP project, then APIs &
# Services > Credentials > Create credentials > API key (restrict it to the Vision
# API). Works the same locally and in the cloud - just a string.
GOOGLE_VISION_API_KEY=

# how many jobs the worker processes at once
WORKER_CONCURRENCY=5
# slow each job down (ms) to watch the queue back up while testing. 0 = off.
PROCESSING_DELAY_MS=0
