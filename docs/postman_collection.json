{
  "info": {
    "name": "Media processing pipeline",
    "description": "Auth, upload, jobs and notifications for the media processing microservice.\n\nSet `base_url` to the deployed api or http://localhost:4000. Run Signup or Login first - it saves the access + refresh tokens into collection variables, and the rest of the requests use them automatically. Creating a job saves its id into `job_id`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://ai-powered-media-processing-1018445335768.asia-south2.run.app"
    },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "job_id", "value": "" },
    { "key": "notification_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["auth", "signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"supersecret\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.accessToken) pm.collectionVariables.set('access_token', j.accessToken);",
                  "if (j.refreshToken) pm.collectionVariables.set('refresh_token', j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"supersecret\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.accessToken) pm.collectionVariables.set('access_token', j.accessToken);",
                  "if (j.refreshToken) pm.collectionVariables.set('refresh_token', j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.accessToken) pm.collectionVariables.set('access_token', j.accessToken);",
                  "if (j.refreshToken) pm.collectionVariables.set('refresh_token', j.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "Create job (upload)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/jobs", "host": ["{{base_url}}"], "path": ["jobs"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "jpg, png or webp, max 5MB"
                }
              ]
            },
            "description": "Upload an image. Returns the job id immediately; processing happens in the background."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.jobId) pm.collectionVariables.set('job_id', j.jobId);"
                ]
              }
            }
          ]
        },
        {
          "name": "List jobs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/jobs", "host": ["{{base_url}}"], "path": ["jobs"] }
          }
        },
        {
          "name": "Get job",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/jobs/{{job_id}}",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{job_id}}"]
            },
            "description": "Full job with results (caption, labels, safety, flagged)."
          }
        },
        {
          "name": "Get job image",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/jobs/{{job_id}}/image",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{job_id}}", "image"]
            },
            "description": "Streams the original uploaded image back."
          }
        },
        {
          "name": "Retry job",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/jobs/{{job_id}}/retry",
              "host": ["{{base_url}}"],
              "path": ["jobs", "{{job_id}}", "retry"]
            },
            "description": "Re-enqueue a failed job. Resumes from the step that failed."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/notifications",
              "host": ["{{base_url}}"],
              "path": ["notifications"]
            }
          }
        },
        {
          "name": "Mark read",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/notifications/{{notification_id}}/read",
              "host": ["{{base_url}}"],
              "path": ["notifications", "{{notification_id}}", "read"]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    }
  ]
}
